extends SceneTree
## Self-check for tools/solver.gd. Run:   godot --headless -s tools/test_solver.gd
## Compares the GDScript solver with the Python reference's answers in tools/expected_solutions.json
## (generated by reference/python/dump_solutions.py). Exit code 1 if anything disagrees.

const LevelLoader := preload("res://core/level_loader.gd")
const TurnManager := preload("res://core/turn_manager.gd")
const Solver := preload("res://tools/solver.gd")
const CaseRunner := preload("res://tests/case_runner.gd")

const EXPECTED := "res://tools/expected_solutions.json"
const WRONG_ASH := "res://tests/cases/fixtures/FX_wrong_ash_unsolvable.json"

var passed := 0
var failed := 0


func _init() -> void:
	_test_matches_python()
	_test_unsolvable_fixture()
	_test_limit_when_capped()
	_test_early_gate_burn_is_a_dead_end()
	_test_finished_states()
	print("\n%d passed, %d failed" % [passed, failed])
	quit(1 if failed > 0 else 0)


func _check(ok: bool, label: String, detail: String = "") -> void:
	if ok:
		passed += 1
		print("PASS  %s" % label)
	else:
		failed += 1
		print("FAIL  %s  %s" % [label, detail])


func _load_state(path: String):
	var loaded := LevelLoader.load_file(path)
	if loaded["state"] == null:
		print("cannot load %s: %s" % [path, loaded["error"]])
	return loaded["state"]


func _play(state, shorthand: Array):
	for short in shorthand:
		var result := TurnManager.apply_action(state, CaseRunner.parse_action(short))
		if not result["ok"]:
			return null
		state = result["state"]
	return state


func _test_matches_python() -> void:
	var text := FileAccess.get_file_as_string(EXPECTED)
	var expected = JSON.parse_string(text)
	if typeof(expected) != TYPE_DICTIONARY:
		_check(false, "read %s" % EXPECTED)
		return
	for level_id in expected:
		var state = _load_state("res://levels/data/%s.json" % level_id)
		if state == null:
			_check(false, "%s loads" % level_id)
			continue
		var result := Solver.solve(state)
		var want: Dictionary = expected[level_id]
		_check(result["status"] == "solved", "%s is solved" % level_id, str(result["status"]))
		_check(result["actions"].size() == int(want["length"]),
			"%s shortest length matches Python (%d)" % [level_id, int(want["length"])],
			"got %d" % result["actions"].size())
		var got_actions := Solver.actions_to_strings(result["actions"])
		var same: bool = JSON.stringify(got_actions) == JSON.stringify(want["actions"])
		if not same:
			print("NOTE  %s: same length but a different shortest plan than Python (allowed, but tell Mariam)" % level_id)
		# Replaying the plan must really win.
		var end_state = _play(_load_state("res://levels/data/%s.json" % level_id), got_actions)
		_check(end_state != null and end_state.status == "won", "%s plan replays to a win" % level_id)


func _test_unsolvable_fixture() -> void:
	var state = _load_state(WRONG_ASH)
	if state == null:
		_check(false, "wrong-ash fixture loads")
		return
	var result := Solver.solve(state)
	_check(result["status"] == "unsolvable", "FX_wrong_ash_unsolvable is proven unsolvable", str(result["status"]))


func _test_limit_when_capped() -> void:
	var state = _load_state("res://levels/data/L02_wake_the_shadow.json")
	if state == null:
		_check(false, "L02 loads for the cap test")
		return
	_check(Solver.solve(state, 10)["status"] == "limit", "a tiny max_states reports limit")
	_check(Solver.solve(state, 200000, 3)["status"] == "limit", "a tiny max_depth reports limit")


func _test_early_gate_burn_is_a_dead_end() -> void:
	# L02's lesson: burning the gate while its shadow sleeps leaves the level unsolvable.
	var state = _load_state("res://levels/data/L02_wake_the_shadow.json")
	if state == null:
		_check(false, "L02 loads for the dead-end test")
		return
	var after = _play(state, ["move:right", "move:right", "burn:up", "interact", "move:right", "burn:right"])
	_check(after != null, "the early-burn line is playable")
	if after != null:
		_check(Solver.solve(after)["status"] == "unsolvable", "L02 after an early gate burn is unsolvable")


func _test_finished_states() -> void:
	var state = _load_state("res://levels/data/L01_first_crate.json")
	if state == null:
		_check(false, "L01 loads for the finished-state test")
		return
	var solved := Solver.solve(state)
	var won = _play(_load_state("res://levels/data/L01_first_crate.json"), Solver.actions_to_strings(solved["actions"]))
	_check(won != null and Solver.solve(won)["status"] == "solved" and Solver.solve(won)["actions"].is_empty(),
		"an already-won state solves with no actions")
