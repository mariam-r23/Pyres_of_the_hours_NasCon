[
 {
  "name": "actions_per_hour 2: the hour passes after 2 actions",
  "level": "FX_sun_apH2",
  "actions": [
   "wait",
   "wait",
   "move:right"
  ],
  "expect": {
   "rejected_at": 2,
   "reason": "shadow_blocks",
   "actions_used": 2
  }
 },
 {
  "name": "dial complete before the exit fails the level",
  "level": "FX_day",
  "actions": [
   "wait",
   "wait",
   "wait",
   "wait",
   "wait",
   "wait"
  ],
  "expect": {
   "won": false,
   "failed": true,
   "actions_used": 6
  }
 },
 {
